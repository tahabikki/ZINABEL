# -----------------------------
# Comprehensive .gitignore
# - Python + virtualenvs
# - Node + frontend builds
# - Docker, IDEs, OS files, logs, databases
# -----------------------------

### Python ###
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

### Virtual environments / env files ###
# Keep `.env` and other local env files out of the repo
.env
.env.*
.env.local
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

### Testing / coverage ###
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/

### Type checkers / linters ###
.mypy_cache/
.pyright/

### Jupyter ###
.ipynb_checkpoints/

### Node / JavaScript ###
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.pnp/
.pnp.js
# Note: Do NOT ignore lockfiles (package-lock.json, yarn.lock, pnpm-lock.yaml)

### Frontend build outputs ###
frontend/dist/
frontend/build/
dist/
build/

### Docker ###
docker-compose.override.yml
docker-compose.*.local.yml
*.local.env

### Database files ###
*.db
*.sqlite
*.sqlite3
database/

### Logs / runtime ###
*.log
logs/
*.log.*
runtime/
tmp/
temp/
*.pid
flask_session/
backend/flask_session/
.wdm/


### IDEs / Editors ###
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
.vscode-test/

### OS generated files ###
.DS_Store
Thumbs.db
desktop.ini
ehthumbs_vista.db

### Temporary / backup files ###
*.swp
*.swo
*~
*.bak
*.orig

### Compiled / binary files ###
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.obj
*.pyc

### Secrets / keys (make sure these are not committed)
secrets.*
*.pem
*.key
*.crt
credentials/
keys/

### Documentation / build artifacts ###
docs/_build/

### Misc caches ###
.cache/
coverage/

# End of .gitignore
